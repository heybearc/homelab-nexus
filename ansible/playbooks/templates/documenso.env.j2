PORT=3000
NEXTAUTH_SECRET={{ documenso_nextauth_secret }}
NEXT_PRIVATE_ENCRYPTION_KEY={{ documenso_encryption_key }}
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY={{ documenso_encryption_secondary_key }}
NEXT_PUBLIC_WEBAPP_URL=https://{{ documenso_domain }}
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000
NEXT_PRIVATE_DATABASE_URL=postgresql://{{ documenso_db_user }}:{{ documenso_db_password }}@{{ documenso_db_host }}:5432/{{ documenso_db_name }}
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgresql://{{ documenso_db_user }}:{{ documenso_db_password }}@{{ documenso_db_host }}:5432/{{ documenso_db_name }}
NEXT_PUBLIC_UPLOAD_TRANSPORT=database
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=mail-relay
NEXT_PRIVATE_SMTP_PORT=2525
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_SMTP_UNSAFE_IGNORE_TLS=true
NEXT_PRIVATE_SMTP_FROM_NAME=Cloudigan
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@cloudigan.com
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/documenso/cert.p12
NEXT_PRIVATE_SIGNING_PASSPHRASE={{ documenso_cert_passphrase }}
NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=cloudigan.com,cloudigan.net
