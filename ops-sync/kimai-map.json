{
  "_comment": "Maps calendar events to Kimai customers/projects for gap detection and one-click timers. `aliases` match event titles case-insensitively; project prefixes (e.g. 'HPE - General Work' -> 'HPE') match case-sensitively as whole words. Only events in `lifeAreas` are treated as billable blocks unless alsoMatchOtherAreas=true.",
  "lifeAreas": ["cloudigan"],
  "alsoMatchOtherAreas": false,
  "ignoreTitles": [
    "^lunch",
    "^focus",
    "^block",
    "^hold",
    "^busy",
    "^ooo",
    "out of office",
    "^tentative",
    "^commute",
    "^travel"
  ],
  "gapThresholdMinutes": 30,
  "defaultProject": "Cloudy - General Work",
  "defaultActivity": "General Work",
  "preferProjectContaining": "General Work",
  "customers": {
    "BudgetEase": ["budgetease", "budget ease"],
    "Cleveland Wrap": ["cleveland wrap", "clevelandwrap"],
    "Cloudigan Internal": ["cloudigan internal", "cloudy"],
    "Donna Debacco Realtor": ["debacco"],
    "Fastener USA": ["fastener", "fusa"],
    "Highpoint Electric": ["highpoint", "high point"],
    "Kelly's Angels": ["kelly's angels", "kellys angels"],
    "Land Solutions": ["land solutions"],
    "LeadIQ": ["leadiq", "lead iq"],
    "Nil Doctor": ["nil doctor", "nildoctor"],
    "Renvis": ["renvis"],
    "Stack Construction": ["stack construction"],
    "Summit Value Stream": ["summit value", "summit"]
  },
  "projectOverrides": {
    "Cloudigan Internal": "Cloudy - General Work"
  }
}
