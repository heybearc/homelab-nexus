# Automated Container Provisioning Pipeline Configuration
# Copy this file to .env and fill in your credentials

# Proxmox
PROXMOX_HOST=10.92.0.5

# Netbox IPAM
NETBOX_URL=http://10.92.3.18
NETBOX_TOKEN=your-netbox-api-token-here

# Vaultwarden (Ansible deploy-vaultwarden-containers.yml)
VAULTWARDEN_DB_PASSWORD=your-vaultwarden-db-password-here

# Chapter Hub (Ansible deploy-chapter-hub-containers.yml)
CHAPTER_HUB_DB_PASSWORD=your-chapter-hub-db-password-here

# HHV / helpfulhirschventures.com (Ansible deploy-hhv-containers.yml)
# Optional — creates Postgres DB hhv on CT131 for Next.js/Prisma
HHV_DB_PASSWORD=your-hhv-db-password-here
# HHV_REPO=https://github.com/heybearc/hhv.git

# Cloudigan Mail Gateway (Ansible deploy-cloudigan-mail-containers.yml)
# Copy M365_* from: ssh cloudigan-api-blue 'grep ^M365_ /opt/cloudigan-api/.env'
M365_CLIENT_ID=
M365_TENANT_ID=
M365_CLIENT_SECRET=
M365_FROM_EMAIL=noreply@cloudigan.com
# Optional — auto-generated at deploy if empty:
CLOUDIGAN_MAIL_API_KEYS=chapter-hub:hexkey,cloudigan-api:hexkey,n8n-cron:hexkey

# Nginx Proxy Manager
NPM_URL=http://10.92.3.33:81
NPM_EMAIL=admin@cloudigan.net
NPM_PASSWORD=your-npm-password-here

# AdGuard Home DNS (primary CT140)
ADGUARD_URL=http://10.92.3.11:3000
ADGUARD_USER=admin
ADGUARD_PASSWORD=your-adguard-password-here

# Technitium DNS (primary CT145 + standby on TrueNAS)
# Admin password is set in the Technitium UI — NOT stored in .env.
# Optional: non-expiring API token for scripts (Administration → API tokens)
# TECHNITIUM_API_TOKEN=
# TECHNITIUM_STANDBY_API_TOKEN=
TECHNITIUM_URL=http://10.92.3.10:5380
TECHNITIUM_STANDBY_URL=http://10.92.3.203:5380
# Optional — TSIG secret for zone transfer (hex); generate in Technitium UI if empty
DNS_TSIG_SECRET=

# TrueNAS
TRUENAS_HOST=10.92.0.3

# Monitoring
LOKI_URL=http://10.92.3.2:3100

# Backup
BACKUP_STORAGE=local
BACKUP_TIME=02:00
BACKUP_RETENTION=keep-last=7,keep-weekly=4,keep-monthly=3

# n8n Automation Platform
N8N_API_URL=https://n8n.cloudigan.net/api/v1
N8N_API_TOKEN=your-n8n-api-token-here

# Vikunja Task Management
VIKUNJA_API_URL=https://tasks.cloudigan.net/api/v1
VIKUNJA_API_TOKEN=your-vikunja-api-token-here

# Kimai Time Tracking (Profile → API → generate token)
KIMAI_API_URL=https://time.cloudigan.net/api
KIMAI_API_USER=cory@cloudigan.com
KIMAI_API_TOKEN=your-kimai-api-token-here

# Prometheus (alert healer — close recovered Vikunja + Zammad tickets)
PROMETHEUS_URL=http://10.92.3.2:9090

# Zammad (Profile → Token Access) — for setup-zammad-close-trigger.sh + alert healer
ZAMMAD_API_URL=https://support.cloudigan.net
ZAMMAD_API_TOKEN=your-zammad-api-token-here
# Entra OAuth app secret (SSO login only — NOT the API token)
ZAMMAD_OAUTH_CLIENT_SECRET=

# Ops Hub stack (app source: https://github.com/heybearc/ops-hub)
OPS_HUB_REPO=https://github.com/heybearc/ops-hub.git
OPS_HUB_ROOT=
OPS_HUB_URL=https://ops.cloudigan.net
NTFY_URL=https://push.cloudigan.net
NTFY_TOPIC=cory-daily-briefing
OPS_SYNC_URL=http://127.0.0.1:3002
N8N_OPS_CAPTURE_URL=https://flows.cloudigan.net/webhook/ops-capture
N8N_OPS_TIMER_URL=https://flows.cloudigan.net/webhook/ops-kimai-timer

# Google Calendar OAuth (ops-hub + ops-sync — see documentation/OPS-HUB-GOOGLE-CALENDAR-OAUTH.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://ops.cloudigan.net/api/auth/google/callback

# Microsoft Graph calendar OAuth (ops-hub + ops-sync — separate app from mail-send daemon)
# Create multitenant Entra app with delegated Calendars.Read — see documentation/OPS-HUB-M365-CALENDAR-OAUTH.md
M365_CALENDAR_REDIRECT_URI=https://ops.cloudigan.net/api/auth/microsoft/callback
M365_CALENDAR_USER=cory@cloudigan.com

# Ops Hub — time gaps, bills, briefing (ops-sync)
OPS_TIMEZONE=America/New_York
OPS_TIMELOG_THRESHOLD_MIN=30            # flag calendar blocks with ≥ this many unlogged minutes
VIKUNJA_PROJECT_ID=1                    # where gap/bill tasks go (1 = Inbox)
OPS_BRIEFING_CONFLICTS=high             # high = cross-calendar only | all
OPS_QUOTA_WARN_PCT=80                   # ntfy + briefing when used ≥ this %
OPS_QUOTA_CRITICAL_PCT=95
OPS_QUOTA_SNOOZE_DAYS=3                 # don't re-alert the same customer+level sooner

# Optional LLM headline for the morning briefing (leave all blank to disable)
# OPS_LLM_PROVIDER=anthropic | openai | ollama  (auto-detected from whichever key is set)
OPS_LLM_PROVIDER=
OPS_LLM_MODEL=                          # e.g. claude-3-5-haiku-latest, gpt-4o-mini, llama3.1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=                             # e.g. http://10.92.3.x:11434

# LibreTranslate API
LIBRETRANSLATE_API_URL=https://libretranslate.cloudigan.net
LIBRETRANSLATE_API_KEY=your-libretranslate-api-key-here
